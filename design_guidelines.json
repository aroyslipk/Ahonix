      "style": "sticky top-0 z-40 bg-[#08090E]/90 backdrop-blur-md border-b border-[#1E2235] px-6 py-3 flex items-center justify-between",
      "elements": [
        "AHONIX Logo with Emerald Sparkle Icon",
        "Demo Workspace Switcher (Northstar Goods - Shopify + Amazon)",
        "Global Search Bar",
        "Global 'Ask AHONIX ✦' Button",
        "Action Center Pending Indicator Pill",
        "Onboarding Progress Meter",
        "Notifications & User Avatar"
      ]
    },
    "sidebar": {
      "style": "w-64 bg-[#0F111A] border-r border-[#1E2235] flex flex-col justify-between p-4 hidden md:flex min-h-screen",
      "sections": [
        { "name": "Overview", "icon": "LayoutDashboard", "path": "/overview" },
        { "name": "AI Intelligence", "icon": "BrainCircuit", "path": "/ai-intelligence", "badge": "Business X-Ray" },
        { "name": "Sales Analytics", "icon": "TrendingUp", "path": "/sales" },
        { "name": "Product Health", "icon": "Package", "path": "/products" },
        { "name": "Inventory Forecast", "icon": "Boxes", "path": "/inventory" },
        { "name": "Marketing ROAS", "icon": "Target", "path": "/marketing" },
        { "name": "Customers & LTV", "icon": "Users", "path": "/customers" },
        { "name": "Operations & Logistics", "icon": "Truck", "path": "/operations" },
        { "name": "Markets & Simulator", "icon": "Globe", "path": "/markets" },
        { "name": "Action Center", "icon": "CheckSquare", "path": "/action-center", "badge": "7 Pending" },
        { "name": "Settings & Integrations", "icon": "Settings", "path": "/settings" }
      ]
    }
  },
  "component_specifications": {
    "kpi_card": {
      "container": "bg-[#121420] border border-[#1E2235] rounded-xl p-5 hover:border-[#10B981]/40 transition-all shadow-sm relative overflow-hidden",
      "header": "flex items-center justify-between text-xs font-medium text-[#94A3B8] mb-2",
      "value": "text-2xl sm:text-3xl font-extrabold font-mono text-[#F8FAFC]",
      "comparison": "flex items-center gap-2 mt-2 text-xs",
      "trend_badge_positive": "inline-flex items-center text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded font-medium",
      "trend_badge_negative": "inline-flex items-center text-rose-400 bg-rose-500/10 px-2 py-0.5 rounded font-medium",
      "meta": "Must show tag badge: [ACTUAL], [ESTIMATED], or [PROJECTED]"
    },
    "ai_insight_card": {
      "container": "bg-[#161926] border border-[#1E2235] rounded-xl p-6 relative border-l-4",
      "severity_levels": {
        "critical": "border-l-rose-500 bg-rose-950/10",
        "opportunity": "border-l-emerald-500 bg-emerald-950/10",
        "warning": "border-l-amber-500 bg-amber-950/10"
      },
      "structure": [
        "Header: Insight Category + Confidence Score Badge (e.g. '94% Confidence')",
        "Title & Money Leak / Opportunity Impact Amount (e.g. '+$42,500/mo Revenue Opportunity')",
        "Evidence Breakdown: 2-3 Bullet Points with Data Proof",
        "Simulated Projection Chart / Micro-Visualizer",
        "Action Buttons: [Simulate Impact] [Approve & Execute] [Ask AI Analyst]"
      ]
    },
    "action_center_lifecycle": {
      "stages": ["Detected", "Explained", "Simulated", "Awaiting Approval", "Approved", "Executed", "Measured"],
      "stage_colors": {
        "Detected": "bg-slate-800 text-slate-300",
        "Explained": "bg-cyan-950/50 text-cyan-300 border-cyan-800",
        "Simulated": "bg-purple-950/50 text-purple-300 border-purple-800",
        "Awaiting Approval": "bg-amber-950/50 text-amber-300 border-amber-800 animate-pulse",
        "Approved": "bg-blue-950/50 text-blue-300 border-blue-800",
        "Executed": "bg-emerald-950/50 text-emerald-300 border-emerald-800",
        "Measured": "bg-emerald-900 text-emerald-200 border-emerald-500"
      }
    },
    "ask_ahonix_overlay": {
      "style": "fixed inset-y-0 right-0 w-full max-w-xl bg-[#0F111A] border-l border-[#1E2235] shadow-2xl z-50 flex flex-col",
      "input": "bg-[#161926] border border-[#2D334B] rounded-xl p-3 text-sm text-[#F8FAFC] focus:border-[#10B981] focus:ring-1 focus:ring-[#10B981] outline-none",
      "quick_prompts": [
        "Why did margin drop 3.2% yesterday?",
        "Simulate increasing Meta ad spend by $5,000 next month",
        "Which inventory items will stock out in under 14 days?",
        "Show me true net profit after returns & shipping fees"
      ]
    },
    "business_xray_scan": {
      "scanning_animation": "Pulse ring visualizer with animated radar sweep effect in Emerald/Cyan tones",
      "sections": ["Money Leaks", "Growth Opportunities", "Operational Risks", "Customer Churn Risks", "Inventory Bottlenecks"]
    },
    "true_profit_waterfall": {
      "elements": ["Gross Revenue", "Discounts & Refunds", "Net Revenue", "COGS", "Shipping Costs", "Marketing Spend", "Payment Fees", "True Net Profit"]
    }
  },
