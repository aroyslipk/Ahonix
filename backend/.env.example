# ==============================================================================
# AHONIX Backend — Production & Development Environment Configuration
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit real secret values to source control.
# ==============================================================================

# --- Database Configuration ---------------------------------------------------
# For local development:
#   MONGO_URL=mongodb://localhost:27017
# For Docker Compose:
#   MONGO_URL=mongodb://mongo:27017
# For MongoDB Atlas (Production):
#   MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=ahonix_db

# --- CORS & Networking --------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# DO NOT use wildcard '*' when credentials (cookies) are enabled.
# Local development example:
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example:
#   CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (used for OAuth redirects and canonical links)
FRONTEND_URL=http://localhost:3000

# Application URL (used by backend to detect HTTPS production vs HTTP localhost.
# If URL does not contain 'localhost' or '127.0.0.1', cookies are set with Secure=True and SameSite=None)
APP_URL=http://localhost:3000

# --- Authentication & Security ------------------------------------------------
# JWT signing secret — in production, generate a cryptographically strong 64-char hex string:
# Command: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_hex_string_for_production

# Internal Cron Secret (Phase 6.4)
# Header: X-Cron-Secret: <CRON_SECRET>
# Protects internal automated jobs (e.g., POST /api/internal/cron/sync-marketing).
# Command: openssl rand -hex 32
CRON_SECRET=

# Seed Admin Credentials (seeded on first startup if user does not exist)
ADMIN_EMAIL=alex@northstargoods.com
ADMIN_PASSWORD=CHANGE_ME_set_a_strong_password_Ahonix2026!

# --- AI Intelligence (Ask AHONIX) --------------------------------------------
# Configure at least one AI provider for the Ask AHONIX analyst drawer.
# Priority order: Groq -> OpenAI -> Gemini -> Anthropic -> Emergent Fallback
#
# Option 1: Groq (Recommended — Ultra-fast & cost-effective OpenAI-compatible API)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# Option 2: OpenAI / Compatible
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Option 3: Google Gemini
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash
#
# Option 4: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
#
# Option 5: Emergent Sandbox Fallback (emergentintegrations only)
EMERGENT_LLM_KEY=sk-your-emergent-key-here


# --- Shopify Integration (Phase 3.1) -----------------------------------------
# Obtain credentials from Shopify Partners Dashboard: https://partners.shopify.com
# Create a Custom or Public Distribution App and configure:
#   Allowed redirection URL: {APP_URL}/api/integrations/shopify/callback
SHOPIFY_API_KEY=your_shopify_client_id_or_api_key
SHOPIFY_API_SECRET=your_shopify_client_secret

# Minimum read-only scopes required for AHONIX
SHOPIFY_SCOPES=read_products,read_orders

# Official Shopify Admin API stable version (default: 2026-07)
# Follows Shopify quarterly release schedule (2025-10, 2026-01, 2026-04, 2026-07)
SHOPIFY_API_VERSION=2026-07

# Optional explicit redirect URI override (defaults to {APP_URL}/api/integrations/shopify/callback)
SHOPIFY_REDIRECT_URI=

# Shopify Sync Pagination & Scale (Phase 6.3)
# Maximum items per page requested from Shopify REST API (1-250, default: 250)
SHOPIFY_SYNC_BATCH_SIZE=250
# Maximum pages to fetch during sync (default: 0 = paginate until Shopify indicates no next page exists; set e.g. 3 in tests to cap sync)
SHOPIFY_SYNC_MAX_PAGES=0

# --- Meta Ads Integration (Phase 5.1) ---------------------------------------
# Obtain credentials from Meta for Developers: https://developers.facebook.com
# Create a Business App with Marketing API product and configure:
#   Valid OAuth Redirect URI: {APP_URL}/api/integrations/meta/callback
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
# Configurable Meta Graph API version (default: v21.0)
META_API_VERSION=v21.0
META_SCOPES=ads_read,read_insights
META_REDIRECT_URI=

# --- Meta Ads Insights Sync (Phase 5.2) ---------------------------------------
# Initial sync window in days (default: 28)
META_SYNC_DAYS_INITIAL=28
# Restatement re-fetch window in days to capture attribution updates (default: 3)
META_SYNC_DAYS_RESTATEMENT=3

# --- Google Ads Integration (Phase 5.3) ---------------------------------------
# Obtain credentials from Google Cloud Console: https://console.cloud.google.com
# Configure OAuth 2.0 Client ID (Web application) with authorized redirect URI:
#   {APP_URL}/api/integrations/google-ads/callback
# Scope required: https://www.googleapis.com/auth/adwords
GOOGLE_ADS_CLIENT_ID=your_google_ads_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_client_secret_here
# Developer Token from Google Ads Manager Account (API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token_here
GOOGLE_ADS_REDIRECT_URI=
GOOGLE_ADS_API_VERSION=v19

# --- Google Ads Insights Sync (Phase 5.4) ------------------------------------
# Initial sync window in days (default: 28)
GOOGLE_ADS_SYNC_DAYS_INITIAL=28
# Restatement re-fetch window in days to capture attribution updates (default: 3)
GOOGLE_ADS_SYNC_DAYS_RESTATEMENT=3
# --- Google OAuth Authentication ---------------------------------------------
# For Google One-Tap / OAuth sign in:
# Configure in Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Emergent OAuth key for sandbox environments
EMERGENT_AUTH_KEY=

# --- Transactional Email & Verification (Phase 6.2) ---------------------------
# Resend API (Recommended Free Tier: 100 emails/day, 3,000/month free)
# Sign up at https://resend.com and obtain an API key.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Or Traditional SMTP configuration:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Stripe Billing & Subscriptions -------------------------------------------
# Obtain keys from Stripe Dashboard: https://dashboard.stripe.com/apikeys
# If STRIPE_SECRET_KEY is empty, AHONIX runs in truthful Free Tier / Unconfigured mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

