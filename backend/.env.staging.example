# ==============================================================================
# AHONIX Backend — Staging Environment Configuration Template
# Target Domain: https://staging.ahonix.com (Single-Origin Architecture)
# Copy this file to backend/.env.staging and populate with staging credentials.
# NEVER commit real secret values to source control.
# ==============================================================================

# --- Staging Database (MongoDB Atlas) -----------------------------------------
# Separate staging database namespace (DO NOT point staging to production database)
MONGO_URL=mongodb+srv://<staging_db_user>:<staging_db_password>@<cluster>.mongodb.net/ahonix_staging?retryWrites=true&w=majority&appName=AHONIX
DB_NAME=ahonix_staging

# --- Single-Origin URLs & Networking ------------------------------------------
# All traffic originates from and routes through https://staging.ahonix.com
APP_URL=https://staging.ahonix.com
FRONTEND_URL=https://staging.ahonix.com
CORS_ORIGINS=https://staging.ahonix.com

# --- Authentication & Session Security ----------------------------------------
# Generate a cryptographically strong 64-char hex secret: openssl rand -hex 32
JWT_SECRET=PLACEHOLDER_generate_staging_64_char_hex_secret

# Initial staging admin account seeded on first boot
ADMIN_EMAIL=staging-admin@ahonix.com
ADMIN_PASSWORD=PLACEHOLDER_set_a_strong_staging_admin_password

# --- AI Intelligence (Ask AHONIX) --------------------------------------------
# Configure at least one AI provider for the Ask AHONIX analyst drawer.
# Priority order: Groq -> OpenAI -> Gemini -> Anthropic -> Emergent Fallback
#
# Option 1: Groq (Recommended for ultra-fast, cost-effective streaming)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# Option 2: OpenAI / Compatible
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Option 3: Google Gemini
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash
#
# Option 4: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
#
# Option 5: Emergent Sandbox Fallback (emergentintegrations only)
EMERGENT_LLM_KEY=


# --- Shopify Integration (Staging Dev App) ------------------------------------
# Configure in Shopify Partner Dashboard:
#   App URL: https://staging.ahonix.com
#   Allowed redirection URL: https://staging.ahonix.com/api/integrations/shopify/callback
#   Webhook address: https://staging.ahonix.com/api/integrations/shopify/webhooks
SHOPIFY_API_KEY=your_staging_shopify_client_id
SHOPIFY_API_SECRET=your_staging_shopify_client_secret
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,read_orders
SHOPIFY_REDIRECT_URI=https://staging.ahonix.com/api/integrations/shopify/callback
SHOPIFY_SYNC_BATCH_SIZE=250
SHOPIFY_SYNC_MAX_PAGES=0

# --- Transactional Email (Staging SMTP) ---------------------------------------
# Supply credentials from your staging mailbox / test mail provider (e.g. Mailtrap, Postmark test server)
# If left empty, safe development fallback is active (simulates delivery without crashing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=AHONIX Staging <staging-security@ahonix.com>

# --- Meta Ads Integration (Staging App) --------------------------------------
# Configure in Meta for Developers:
#   Valid OAuth Redirect URI: https://staging.ahonix.com/api/integrations/meta/callback
META_APP_ID=your_staging_meta_app_id
META_APP_SECRET=your_staging_meta_app_secret
META_API_VERSION=v21.0
META_SCOPES=ads_read,read_insights
META_REDIRECT_URI=https://staging.ahonix.com/api/integrations/meta/callback

# --- Google OAuth (User Signup & Login) ---------------------------------------
# Configure in Google Cloud Console (OAuth 2.0 Web Client):
#   Authorized JavaScript origins:
#     https://ahonix-staging-frontend.onrender.com
#     https://ahonix-staging-backend.onrender.com
#   Authorized redirect URI:
#     https://ahonix-staging-backend.onrender.com/api/auth/google/callback
# Note: Falls back to GOOGLE_ADS_CLIENT_ID / GOOGLE_ADS_CLIENT_SECRET if unset.
GOOGLE_CLIENT_ID=your_staging_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_staging_google_client_secret
GOOGLE_AUTH_REDIRECT_URI=https://ahonix-staging-backend.onrender.com/api/auth/google/callback

# --- Google Ads Integration (Staging App) -------------------------------------
# Configure in Google Cloud Console:
#   Authorized redirect URI: https://staging.ahonix.com/api/integrations/google-ads/callback
GOOGLE_ADS_CLIENT_ID=your_staging_google_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_staging_google_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=your_staging_google_developer_token
GOOGLE_ADS_API_VERSION=v19
GOOGLE_ADS_REDIRECT_URI=https://staging.ahonix.com/api/integrations/google-ads/callback

# --- Automated Marketing Cron (Internal Job Secret) --------------------------
# Required in header: X-Cron-Secret: <CRON_SECRET> for POST /api/internal/cron/sync-marketing
# Generate with: openssl rand -hex 32
CRON_SECRET=PLACEHOLDER_generate_staging_cron_secret

