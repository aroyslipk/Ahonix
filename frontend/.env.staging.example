# ==============================================================================
# AHONIX Frontend — Staging Environment Configuration Template
# Target Domain: https://staging.ahonix.com (Single-Origin Architecture)
# ==============================================================================

# Backend API URL:
# In single-origin staging, leave REACT_APP_BACKEND_URL blank/empty.
# Nginx proxies all relative /api/* requests directly to the backend container.
REACT_APP_BACKEND_URL=

# WebSocket port for development HMR (not used in production build)
WDS_SOCKET_PORT=443

# Webpack Health Plugin toggle
ENABLE_HEALTH_CHECK=false
