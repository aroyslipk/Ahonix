# ==============================================================================
# AHONIX Frontend — Production & Development Environment Configuration
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Backend API URL:
# - For local development (backend running on port 8000):
#   REACT_APP_BACKEND_URL=http://localhost:8000
# - For same-origin deployment or reverse proxy (Nginx / Cloud Run / Kubernetes routing /api):
#   REACT_APP_BACKEND_URL=
# - For cross-origin production (backend on separate domain):
#   REACT_APP_BACKEND_URL=https://api.yourdomain.com
REACT_APP_BACKEND_URL=http://localhost:8000

# WebSocket Port for Webpack Dev Server Hot-Module Reloading (HMR):
# Use 443 if running behind HTTPS cloud proxy; 3000 for standard local dev.
WDS_SOCKET_PORT=3000

# Webpack Health Plugin toggle (true/false)
ENABLE_HEALTH_CHECK=false
